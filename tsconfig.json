{
  "compilerOptions": {
    "target": "ES2023",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "jsx": "react-jsx",
    "strict": true,
    "skipLibCheck": true,
    "resolveJsonModule": true,
    "esModuleInterop": true,
    "noEmit": true,
    "types": [
      "node",
      "react",
      "@tscircuit/core"
    ]
  },
  "include": [
    "pcb/crimpdeq/tscircuit/**/*.ts",
    "pcb/crimpdeq/tscircuit/**/*.tsx",
    "scripts/**/*.ts",
    "index.circuit.tsx"
  ]
}
