{
  "name": "Crimpdeq - TSCircuit",
  "private": true,
  "type": "module",
  "scripts": {
    "postinstall": "node scripts/patch-viewer.mjs && node scripts/patch-core.mjs",
    "dev": "tsci dev",
    "build": "tsci build index.circuit.tsx",
    "verify": "python3 scripts/netlist.py && tsci check placement index.circuit.tsx && tsci check schematic-placement index.circuit.tsx && tsci build index.circuit.tsx && python3 scripts/routing.py && bun scripts/drc.ts && tsci check shorts dist/index/circuit.json && bun scripts/fab-json.ts",
    "fab": "scripts/fab.sh",
    "site": "scripts/site.sh",
    "site:deploy": "scripts/site.sh --deploy",
    "search": "python3 scripts/search.py",
    "render": "bun scripts/render.ts",
    "typecheck": "tsc --noEmit"
  },
  "devDependencies": {
    "@resvg/resvg-js": "2.6.2",
    "@tscircuit/checks": "0.0.233",
    "@types/react": "19.3.0",
    "bun": "1.4.2",
    "circuit-to-svg": "0.0.438",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "three": "0.186.1",
    "tscircuit": "0.0.2742",
    "typescript": "5.9.3"
  }
}
